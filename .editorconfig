root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# Mapperly: a member without a counterpart is a COMPILE ERROR, not a silently empty field.
# (The Playmove converter forgot City/State and nothing warned - see the planning, 01 #3.)
# RMG012: target member without a source. RMG020: source member not mapped to any target.
dotnet_diagnostic.RMG012.severity = error
dotnet_diagnostic.RMG020.severity = error
